{
  "manifest_version": 3,
  "name": "AI Email Reply Assistant",
  "version": "1.0.0",
  "description": "Generate 3 professional email reply options using AI.",
  
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],

  "icons": {
    "256": "icons/icon128.png"  
  },

  "action": {
    "default_title": "AI Email Reply Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "256": "icons/icon128.png"
    }
  }
}